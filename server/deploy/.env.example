# Скопировать в /opt/stultus/.env на виртуалке. В репозиторий не попадает.

# Порт gateway (WebSocket для плагинов + MCP для моделей).
PORT=8790

# Пропуск, который сотрудники вводят в настройках плагина. Обязателен.
PLUGIN_TOKEN=замените-на-длинную-случайную-строку

# --- Claude -----------------------------------------------------------------
# Подписка: на машине, где выполнен вход, `claude setup-token` печатает токен.
CLAUDE_CODE_OAUTH_TOKEN=
# Либо ключ API вместо подписки.
ANTHROPIC_API_KEY=
CLAUDE_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
CLAUDE_DEFAULT_MODEL=claude-opus-5
# Только для разработки: считать Claude настроенным без токена / свой путь к Claude Code.
# CLAUDE_ASSUME_LOGGED_IN=1
# CLAUDE_CODE_PATH=

# --- Codex ------------------------------------------------------------------
# Ключ API; либо `codex login --device-auth` в контейнере (auth.json в томе).
CODEX_API_KEY=
CODEX_MODELS=gpt-5.5,gpt-5.5-codex,gpt-5-codex-mini
CODEX_DEFAULT_MODEL=gpt-5.5

# --- Постпродакшн текущего вьюпорта ------------------------------------------
# Встроенная генерация Codex по подписке. Сначала выполнить codex login
# под тем же пользователем, от которого работает gateway, затем включить.
# Не использует CODEX_API_KEY как замену входу ChatGPT для image generation.
RENDER_ENABLED=0
# Пустой путь: CLI из зависимостей npm. Явный путь полезен для отдельной установки.
RENDER_CODEX_PATH=
# Пусто: CODEX_DEFAULT_MODEL. Это модель агента, не имя модели изображений.
RENDER_MODEL=
RENDER_TIMEOUT_MS=600000

# --- Выход в интернет через локальный прокси (если нужен) ---------------------
# Процессы Claude Code / Codex запускаются с окружением gateway. Одного
# HTTPS_PROXY мало: встроенный fetch в Node его игнорирует без NODE_USE_ENV_PROXY.
# Адреса плагинов и сам MCP (127.0.0.1) — мимо прокси.
# HTTPS_PROXY=http://127.0.0.1:8888
# HTTP_PROXY=http://127.0.0.1:8888
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,192.168.0.0/16,172.16.0.0/12

# --- Пределы ----------------------------------------------------------------
MAX_TURNS=150
# Мягкий предел расхода на ход (токены с кэшем); по достижении — вопрос «продолжать?». 0 = без предела.
TURN_TOKEN_BUDGET=400000
# Предел вызовов инструментов за ход (работает и для Codex). 0 = без предела.
TURN_MAX_TOOL_CALLS=60
# Копилка приёмов бюро
RECIPES_PATH=/opt/stultus/data/recipes.json
TOOL_TIMEOUT_MS=600000
