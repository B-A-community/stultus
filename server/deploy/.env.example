# Скопировать в /opt/stultus/.env на виртуалке. В репозиторий не попадает.

# Порт gateway (WebSocket для плагинов + MCP для моделей).
PORT=8790
# За Caddy/nginx на VPS слушать только localhost; в локальной сети бюро — 0.0.0.0.
HOST=0.0.0.0

# Пропуск, который сотрудники вводят в настройках плагина. Обязателен.
PLUGIN_TOKEN=замените-на-длинную-случайную-строку

# --- Claude -----------------------------------------------------------------
# Подписка: на машине, где выполнен вход, `claude setup-token` печатает токен.
CLAUDE_CODE_OAUTH_TOKEN=
# Либо ключ API вместо подписки.
ANTHROPIC_API_KEY=
CLAUDE_MODELS=claude-opus-5:Opus 5,claude-sonnet-5:Sonnet 5,claude-haiku-4-5:Haiku 4.5
CLAUDE_DEFAULT_MODEL=claude-opus-5
# Только для разработки: считать Claude настроенным без токена / свой путь к Claude Code.
# CLAUDE_ASSUME_LOGGED_IN=1
# CLAUDE_CODE_PATH=

# --- Codex ------------------------------------------------------------------
# Ключ API; либо `codex login --device-auth` в контейнере (auth.json в томе).
CODEX_API_KEY=
# Список моделей для окна: `id` или `id:Подпись` через запятую. Какие есть —
# отдаёт `codex app-server` (model/list); на 2026-09-17: gpt-6-astra,
# gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.5, gpt-5.2.
CODEX_MODELS=gpt-6-astra:GPT-6 Astra · Топовая,gpt-5.6-sol:GPT-5.6 Sol · Мощная,gpt-5.6-terra:GPT-5.6 Terra · Средняя,gpt-5.6-luna:GPT-5.6 Luna · Слабая
CODEX_DEFAULT_MODEL=gpt-6-astra

# --- Постпродакшн текущего вьюпорта ------------------------------------------
# Встроенная генерация Codex по подписке. Сначала выполнить codex login
# под тем же пользователем, от которого работает gateway, затем включить.
# Не использует CODEX_API_KEY как замену входу ChatGPT для image generation.
RENDER_ENABLED=0
# Пустой путь: CLI из зависимостей npm. Явный путь полезен для отдельной установки.
RENDER_CODEX_PATH=
# Пусто: CODEX_DEFAULT_MODEL. Это модель агента, не имя модели изображений.
RENDER_MODEL=
RENDER_TIMEOUT_MS=600000
# «Большой кадр» 4K/6K/8K (3840/5760/7680 px, сетки 3×2/4×3/6×3 — в tiles.ts).
# Генератор отдаёт ~1,6 мегапикселя и размер входа игнорирует, поэтому кадр
# собирается из плиток: эталон целиком + плитки по эталону, сшивка с нахлёстом.
# Цена: 1 + столбцы×строки генераций (7/13/19). Нахлёст — доля от плитки;
# запас времени на одну генерацию для общего таймаута; RENDER_KEEP_LAST=1
# оставляет последний собранный кадр в WORK_DIR/renders/last-large.png.
RENDER_LARGE_OVERLAP=0.12
RENDER_LARGE_PER_GENERATION_MS=180000
RENDER_KEEP_LAST=0
# Сколько модель ждёт ответа инструмента плагина (8K-кадр — около 15 минут).
MCP_TOOL_TIMEOUT_MS=2700000
# Сколько ждать решения человека в карточке (снимок, визуализация).
CONSENT_TIMEOUT_MS=1200000

# --- Массинг по карте --------------------------------------------------------
# Контуры и этажность зданий — OpenStreetMap через Overpass; зеркала по порядку.
OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Российские геокодеры по ключам (приоритет над Nominatim).
# YANDEX_GEOCODER_KEY — бесплатный лимит на developer.tech.yandex.ru.
# DGIS_KEY даёт ещё и этажность, но доступ к API 2GIS платный и дорогой;
# без него высоты без данных подбираются по соседним зданиям.
YANDEX_GEOCODER_KEY=
DGIS_KEY=
# Браузер на сервере (Playwright + Chromium): простой вкладки и таймаут страницы, мс.
BROWSER_IDLE_MS=600000
BROWSER_TIMEOUT_MS=90000

# Таймаут запроса к геосервису, мс; предел радиуса, м.
GEO_TIMEOUT_MS=30000
GEO_MAX_RADIUS=1500

# --- Выход в интернет через локальный прокси (если нужен) ---------------------
# Процессы Claude Code / Codex запускаются с окружением gateway. Одного
# HTTPS_PROXY мало: встроенный fetch в Node его игнорирует без NODE_USE_ENV_PROXY.
# Адреса плагинов и сам MCP (127.0.0.1) — мимо прокси.
# HTTPS_PROXY=http://127.0.0.1:8888
# HTTP_PROXY=http://127.0.0.1:8888
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1,192.168.0.0/16,172.16.0.0/12

# --- Пределы ----------------------------------------------------------------
MAX_TURNS=150
# Мягкий предел расхода на ход (токены с кэшем); по достижении — вопрос «продолжать?». 0 = без предела.
TURN_TOKEN_BUDGET=400000
# Предел вызовов инструментов за ход (работает и для Codex). 0 = без предела.
TURN_MAX_TOOL_CALLS=60
# Копилка приёмов бюро
RECIPES_PATH=/opt/stultus/data/recipes.json
TOOL_TIMEOUT_MS=600000
